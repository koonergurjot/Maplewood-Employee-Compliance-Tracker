/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600, must-revalidate

/icon-192.svg
  Cache-Control: public, max-age=31536000, immutable

/icon-512.svg
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Service-Worker-Allowed: /
  Cache-Control: no-cache
/\*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'nonce-bWFwbGV3b29k'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  # Limit the permissions policy to directives that ship in stable browsers. Netlify previously appended
  # ad-tech directives such as `browsing-topics` which generate console errors because they require origin
  # trials. By defining the policy explicitly (and mirroring it in netlify.toml) we ensure the header only
  # contains recognised features.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), speaker-selection=(), vibrate=(), fullscreen=(self)

