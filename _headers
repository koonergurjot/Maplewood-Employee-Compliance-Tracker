/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600, must-revalidate

/icon-192.svg
  Cache-Control: public, max-age=31536000, immutable

/icon-512.svg
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Service-Worker-Allowed: /
  Cache-Control: no-cache
/\*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'nonce-bWFwbGV3b29k'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), speaker-selection=(), vibrate=(), fullscreen=(self), sync-xhr=()

